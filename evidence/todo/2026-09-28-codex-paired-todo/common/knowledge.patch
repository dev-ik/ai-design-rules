   });
+  fs.writeFileSync(path.join(directory, 'registry/objects.json'), JSON.stringify({ objects }));
+  fs.writeFileSync(path.join(directory, 'registry/relationships.json'), JSON.stringify({ relationships }));
+  return directory;
